{
  "expo": {
    "name": "ATLAS EFB",
    "slug": "atlas-efb",
    "version": "0.1.0",
    "scheme": "atlasefb",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlasefb.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Konumunuz yalnızca harita üzerinde gösterilmek için cihazda kullanılır; hiçbir sunucuya gönderilmez."
      }
    },
    "android": {
      "package": "com.atlasefb.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Konumunuz yalnızca harita üzerinde gösterilmek için cihazda kullanılır; hiçbir sunucuya gönderilmez.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
